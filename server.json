{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "br.com.pushinpay/mcp",
  "description": "MCP oficial da PushinPay: cobranças PIX, consulta de transações e saldo via IA.",
  "repository": {
    "url": "https://github.com/Pushin-Pay/pushinpay-mcp-server",
    "source": "github"
  },
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@pushinpaybr/mcp-server",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PUSHINPAY_TOKEN",
          "description": "Token da conta PushinPay (gerado no painel).",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "PUSHINPAY_ENV",
          "description": "Ambiente: sandbox (padrão) ou production.",
          "isRequired": false,
          "default": "sandbox"
        }
      ]
    }
  ]
}
